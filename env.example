# Website mailbox (serve.py — local only)
AMASTAN_SITE_HOST=127.0.0.1
AMASTAN_SITE_PORT=8765
AMASTAN_AGENT_TOKEN=
AMASTAN_CHECK_DEMO=0
AMASTAN_CHECK_RATE_LIMIT=30
AMASTAN_JOB_TTL_SEC=120
AMASTAN_LAB_ONLINE_SEC=20
AMASTAN_MAX_LIVE_PER_HOUR=20

# Lab agent (lab-agent.py) — run on the appliance only
# For production site:
#   AMASTAN_MAILBOX_URL=https://amastansolution.com
# For local serve.py:
#   AMASTAN_MAILBOX_URL=http://127.0.0.1:8765
AMASTAN_MAILBOX_URL=https://amastansolution.com
AMASTAN_CLASSIFY_URL=http://127.0.0.1:8010/classify
AMASTAN_CLASSIFY_TOKEN=
AMASTAN_AGENT_CLAIM_WAIT=20
AMASTAN_AGENT_POLL_SEC=1
AMASTAN_TREATED_FILE=

# Cloudflare Pages secrets / bindings (set via scripts, do not commit):
#   AMASTAN_AGENT_TOKEN  — pages secret (same as agent)
#   CHECK_HISTORY        — KV binding for jobs + history
